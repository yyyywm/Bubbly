# ============================================================
#  Bubbly 自动部署 Webhook 监听器 · 环境变量模板
# ============================================================
#  使用方式（仓库目录以 /opt/Bubbly 为例）：
#    cd /opt/Bubbly
#    sudo cp deploy/webhook.env.example deploy/webhook.env
#    sudo chmod 600 deploy/webhook.env
#    sudo nano deploy/webhook.env        # 至少填写 WEBHOOK_SECRET
#    sudo systemctl restart bubbly-webhook
#
#  生成 Secret（两处必须一致）：
#    openssl rand -hex 32
#    → 填入下方 WEBHOOK_SECRET
#    → 填入 GitHub 仓库 Settings → Webhooks → Secret 输入框
#
#  注意：deploy/webhook.env 已被 .gitignore 忽略，禁止提交真实密钥。
# ============================================================

# 与 GitHub Webhook Secret 一致的字符串（必填；泄露等同向所有人开放部署权限）
WEBHOOK_SECRET=change-me-openssl-rand-hex-32

# ---- 以下均为可选项，保持注释即使用默认值 ----

# 监听端口（默认 9000，可自行修改）
# 修改后需同步三处：① sudo systemctl restart bubbly-webhook
# ② 云安全组/防火墙放行的端口  ③ GitHub Webhook 的 Payload URL 端口号
WEBHOOK_PORT=9000

# 仓库目录（默认脚本所在仓库根目录；systemd 单元 WorkingDirectory 已指向 /opt/Bubbly）
#BUBBLY_DIR=/opt/Bubbly

# 跟踪分支（默认 main）
#WEBHOOK_BRANCH=main

# 部署后健康检查地址（默认 http://127.0.0.1:8080/health，与服务器端口对应）
#WEBHOOK_HEALTH_URL=http://127.0.0.1:8080/health

# 覆盖默认部署命令 `docker compose up -d --build`（高级用法，如裸机 systemd 场景）
#WEBHOOK_DEPLOY_CMD=npm ci --omit=dev && systemctl restart bubbly
