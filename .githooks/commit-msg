#!/bin/sh
# Bubbly commit-msg hook
# 校验 commit message 符合 Conventional Commits 规范

msg=$(cat "$1")

# 允许格式: type(scope): 描述  或  type: 描述
pattern='^(feat|fix|docs|refactor|test|chore|style|perf|ci)(\([a-z0-9_/-]+\))?: .+'

if ! echo "$msg" | head -1 | grep -Eq "$pattern"; then
  echo ""
  echo "❌ Commit message 格式不合规"
  echo ""
  echo "允许格式: <type>(<scope>): <描述>"
  echo "        或: <type>: <描述>"
  echo ""
  echo "type 取值: feat | fix | docs | refactor | test | chore | style | perf | ci"
  echo "scope     : 文件名或模块名（小写），如 main、renderer、server"
  echo ""
  echo "示例:"
  echo "  fix(server): 增加心跳保活机制"
  echo "  chore: 补充依赖"
  echo ""
  exit 1
fi

exit 0
