{
  "name": "bubbly",
  "version": "1.0.0",
  "description": "Bubbly - A desktop pet app for couples to chat through love bubbles",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server/index.js",
    "test": "node --test",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ywmywmywm/bubbly.git"
  },
  "keywords": [
    "desktop-pet",
    "websocket",
    "chat",
    "electron",
    "couple"
  ],
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^10.11.0"
  },
  "author": "ywmywmywm",
  "license": "MIT",
  "build": {
    "appId": "com.bubbly.app",
    "productName": "Bubbly",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ]
  }
}
